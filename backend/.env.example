# ==============================================================================
# Smart Customer Complaint Router — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` for local development.
# In production (e.g. Render), configure these under Service > Environment Variables.
# NOTE: Do NOT commit actual secrets or credentials to version control.
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Frontend CORS Configuration
# Comma-separated list of allowed frontend origins (e.g. your production Vercel URL).
# Local development origins (http://localhost:5173, http://127.0.0.1:5173) are always enabled.
# Vercel preview domains (*.vercel.app) are automatically permitted via secure regex.
CORS_ORIGIN=https://your-production-frontend.vercel.app

# Database Configuration (OPTIONAL)
# If left unset or blank, the service operates in standalone ML inference mode.
# Predictions (POST /api/v1/predict) and models metadata remain fully functional without a database.
# For Neon PostgreSQL: postgresql://<username>:<password>@<ep-xyz>.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Administrator Security (Required only for protected GET /api/v1/history access)
# Protects customer inquiry privacy. Set a strong random secret key in production.
ADMIN_API_KEY=your-secure-admin-api-key-here

# Complaint Data Retention Policy
# Number of days to retain complaint audit records before automatic purging (default: 90 days).
COMPLAINT_RETENTION_DAYS=90
